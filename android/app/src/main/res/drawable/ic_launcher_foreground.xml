<?xml version="1.0" encoding="utf-8"?>
<!--
  Original launcher mark: a speech bubble with an agent spark.

  Hand-authored for this app — nothing here is derived from vendor artwork. The
  adaptive foreground canvas is 108x108 with the mark kept inside the 66dp safe
  zone, so launchers that mask it to a circle never clip the tail or the spark.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- bubble outline, open at the bottom right where the tail starts -->
    <path
        android:pathData="M40,34 L68,34 A10,10 0 0,1 78,44 L78,60 A10,10 0 0,1 68,70 L56,70 L44,80 L44,70 L40,70 A10,10 0 0,1 30,60 L30,44 A10,10 0 0,1 40,34 Z"
        android:strokeColor="#4CA66A"
        android:strokeWidth="4.5"
        android:strokeLineJoin="round"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent" />

    <!-- three dots: the reply being composed -->
    <path
        android:pathData="M43,52 m-3.2,0 a3.2,3.2 0 1,0 6.4,0 a3.2,3.2 0 1,0 -6.4,0"
        android:fillColor="#4CA66A" />
    <path
        android:pathData="M54,52 m-3.2,0 a3.2,3.2 0 1,0 6.4,0 a3.2,3.2 0 1,0 -6.4,0"
        android:fillColor="#4CA66A" />
    <path
        android:pathData="M65,52 m-3.2,0 a3.2,3.2 0 1,0 6.4,0 a3.2,3.2 0 1,0 -6.4,0"
        android:fillColor="#4CA66A" />

    <!-- spark: the agent doing the work -->
    <path
        android:pathData="M76,24 L79,31.5 L86.5,34.5 L79,37.5 L76,45 L73,37.5 L65.5,34.5 L73,31.5 Z"
        android:fillColor="#4CA66A" />
</vector>
